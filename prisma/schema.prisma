generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  password   String?
  googleId   String?
  facebookId String?
  linkedinId String?
  appleId    String?
  carAdverts CarAdvert[]

  @@map("users")
}

model CarAdvert {
  id                          String   @id @default(uuid())
  ownerId                     String
  owner                       User     @relation(fields: [ownerId], references: [id])
  mileage                     Int
  registrationNumber          String
  carMake                     String
  carModel                    String
  variant                     String
  carModelDescription         String
  bodyType                    String
  transmission                String
  fuelType                    String
  colour                      String
  drivetrainType              String
  numberOfSeats               Int
  numberOfDoors               Int
  dateOfFirstRegistration     String
  yearOfManufacture           Int
  vehicleIdentificationNumber String
  numberOfPreviousKeepers     Int
  dateOfLastKeeperChange      String
  emissionClass               String
  isStolen                    Boolean  @default(false)
  isScrapped                  Boolean  @default(false)
  isExported                  Boolean  @default(false)
  isImported                  Boolean  @default(false)

  // Engine
  engineCapacity              Int?
  engineSizeL                 Float?
  engineDescription           String?
  engineCylinders             Int?
  engineAspiration            String?
  powerBhp                    Int?
  powerKw                     Int?
  torqueNm                    Int?
  co2Emissions                Int?

  // Performance
  acceleration0To60           Float?
  maxSpeedMph                 Int?

  // Fuel consumption
  fuelConsumptionCombinedMpg  Float?
  fuelConsumptionUrbanMpg     Float?
  fuelConsumptionExtraUrbanMpg Float?

  // Road tax
  roadTaxYearly               Float?
  roadTaxSixMonth             Float?
  vedBand                     String?

  // Origin
  countryOfOrigin             String?

  // EV specific (only populated for electric vehicles)
  evRangeWltpMiles            Int?
  evBatteryDescription        String?
  evBatteryCapacityKwh        Float?
  evBatteryWarrantyMonths     Int?
  evBatteryWarrantyMiles      Int?
  evMaxAcChargePowerKw        Float?
  evMaxDcChargePowerKw        Float?
  evChargeTimeAcMins          Int?
  evChargeTimeDcMins          Int?
  evMotorType                 String?

  title                       String
  description                 String
  price                       Float
  images                      String[]
  email                       String
  mobile                      String
  postcode                    String
  latitude                    Float
  longitude                   Float
  createdAt                   DateTime @default(now())

  @@index([carMake])
  @@index([carModel])
  @@index([variant])
  @@index([price])
  @@index([yearOfManufacture])
  @@index([mileage])
  @@index([transmission])
  @@index([bodyType])
  @@index([colour])
  @@index([numberOfDoors])
  @@index([numberOfSeats])
  @@index([fuelType])
  @@map("car_adverts")
}

model CarMake {
  id     String     @id @default(uuid())
  name   String     @unique
  models CarModel[]

  @@map("car_makes")
}

model CarModel {
  id       String    @id @default(uuid())
  name     String
  makeId   String
  make     CarMake   @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants Variant[]

  @@map("car_models")
}

model Variant {
  id       String   @id @default(uuid())
  name     String
  bodyType String
  year     Int
  modelId  String
  model    CarModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("variants")
}
